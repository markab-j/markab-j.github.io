---
import { getCollection } from "astro:content";
// Page section components
import HeroParticles from "../components/HeroParticles.jsx";
import Icon from "../components/Icon.astro";
import TextType from "../components/react-bits/TextType.jsx";
import WorkMasonry from "../components/WorkMasonry.jsx";
import "../styles/work-masonry.css";
// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from "../layouts/BaseLayout.astro";

// Content Fetching: List four most recent work projects
const projects = (await getCollection("work"))
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
	.slice(0, 4);

// Full Astro Component Syntax:
// https://docs.astro.build/basics/astro-components/
---

<BaseLayout>
	<div class="stack gap-20" data-home-page>
		<header class="wrapper hero">
			<div class="hero-particles" aria-hidden="true">
				<HeroParticles client:load />
			</div>
			<img
				class="hero-logo"
				data-home-rise
				data-rise-delay="80"
				alt="markab-j logo"
				width="512"
				height="523"
				src="/favicon.svg"
			/>
			<div class="interests" data-home-rise data-rise-delay="240">
				<TextType
					client:load
					as="h1"
					prefix="I like "
					text={["developing", "writing", "planning"]}
					initialDelay={450}
					typingSpeed={90}
					pauseDuration={1800}
					deletingSpeed={40}
					typeEffect="rise"
					cursorStyle="bar"
					cursorColor="var(--ink-coral)"
					prefixColor="var(--gray-200)"
					textColors={[
						"var(--link-color)",
						"var(--ink-coral)",
						"var(--ink-peach)",
					]}
				/>
			</div>
		</header>

		<main class="wrapper">
			<section class="section" aria-labelledby="work-title">
				<header class="section-header" data-home-rise data-rise-delay="320">
					<h2 id="work-title">Work</h2>
				</header>

				<div
					class:list={[
						"gallery",
						"work-gallery",
						{ "single-project": projects.length === 1 },
					]}
				>
					<WorkMasonry
						client:load
						items={projects.map(({ id, data }) => ({
							id,
							title: data.title,
							url: `/work/${id}`,
							img: data.img ?? '',
							img_dark: data.img_dark,
							alt: data.img_alt,
						}))}
						columns={projects.length === 1 ? 1 : "auto"}
						columnWidth={360}
						gap={24}
						radius={24}
						captions="hover"
						hoverEffect="lift"
						lightbox={false}
					/>
				</div>

				<div class="cta" data-home-rise data-rise-delay="400">
					<a class="work-link" href="/work">
						<span>View All</span>
						<Icon icon="arrow-right" size="1em" />
					</a>
				</div>
			</section>
		</main>
	</div>
</BaseLayout>

<script>
	const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
	let observer: IntersectionObserver | undefined;
	let animations: Animation[] = [];

	const stopEntrance = () => {
		observer?.disconnect();
		animations.forEach((animation) => animation.cancel());
		animations = [];
	};

	const revealHome = () => {
		stopEntrance();
		if (!document.querySelector('[data-home-page]') || motion.matches) return;

		observer = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (!entry.isIntersecting) return;
				const target = entry.target as HTMLElement;
				animations.push(target.animate([
					{ opacity: 0, transform: 'translateY(3rem)' },
					{ opacity: 1, transform: 'translateY(-0.25rem)', offset: 0.75 },
					{ opacity: 1, transform: 'none' },
				], {
					duration: 600,
					delay: Number(target.dataset.riseDelay ?? 0),
					easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
					fill: 'backwards',
				}));
				observer?.unobserve(target);
			});
		}, { threshold: 0.1 });

		document.querySelectorAll(
			'.site-nav .menu-header, .site-nav .desktop-navigation, .site-nav .menu-footer, ' +
			'.mobile-navigation .staggered-menu-header, [data-home-rise], footer .group, footer .socials',
		).forEach((target) => observer?.observe(target));
	};

	document.addEventListener('astro:page-load', revealHome);
	document.addEventListener('astro:before-swap', stopEntrance);
	motion.addEventListener('change', revealHome);
</script>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
	}

	.hero-particles {
		position: absolute;
		inset-block: -2.5rem;
		inset-inline: calc(50% - 50vw);
		z-index: -1;
		pointer-events: none;
		mask-image: linear-gradient(
			to bottom,
			transparent,
			black 10%,
			black 80%,
			transparent
		);
	}

	.interests {
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		font-weight: 600;
		text-align: center;
	}

	.interests :global(.text-type) {
		min-height: 1.5em;
		min-width: 18ch;
		font-size: inherit;
		line-height: 1.5;
	}

	.hero-logo {
		width: 8rem;
		height: auto;
		filter: drop-shadow(0.5px 0 0 var(--brand-500))
			drop-shadow(-0.5px 0 0 var(--brand-500))
			drop-shadow(0 0.5px 0 var(--brand-500))
			drop-shadow(0 -0.5px 0 var(--brand-500))
			drop-shadow(0 12px 20px rgb(18 55 53 / 18%));
	}

	@media (min-width: 50em) {
		.interests {
			font-size: var(--text-xl);
		}

		.hero-logo {
			width: 10rem;
		}
	}

	.section {
		display: grid;
		grid-template-columns: 1fr auto;
		grid-template-areas: "header cta" "gallery gallery";
		align-items: center;
		gap: 2rem;
	}

	.section-header {
		grid-area: header;
	}

	.section-header h2 {
		font-size: var(--text-2xl);
	}

	.gallery {
		grid-area: gallery;
	}

	.cta {
		grid-area: cta;
	}

	.work-link {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		gap: 0.5rem;
		color: var(--gray-200);
		font-size: var(--text-sm);
		font-weight: 500;
		text-decoration: none;
	}

	.work-link span {
		position: relative;
	}

	.work-link span::after {
		content: '';
		position: absolute;
		inset-inline: 0;
		bottom: -0.2em;
		height: 1px;
		background: currentColor;
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.work-link:hover span::after,
	.work-link:focus-visible span::after {
		transform: scaleX(1);
	}

	@media (prefers-reduced-motion: reduce) {
		.work-link span::after {
			transition: none;
		}
	}

	@media (min-width: 50em) {
		.section {
			gap: 3rem;
		}
	}
</style>
