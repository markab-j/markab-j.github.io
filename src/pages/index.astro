---
import { getCollection } from 'astro:content';
// Component Imports
import CallToAction from '../components/CallToAction.astro';
// Page section components
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import HeroParticles from '../components/HeroParticles.jsx';
import Icon from '../components/Icon.astro';
import TextType from '../components/react-bits/TextType.jsx';
import TechLogoLoop from '../components/TechLogoLoop.jsx';
import Masonry from '../components/react-bits/Masonry.jsx';
import '../styles/work-masonry.css';
// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from '../layouts/BaseLayout.astro';

// Content Fetching: List four most recent work projects
const projects = (await getCollection('work'))
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
	.slice(0, 4);

// Full Astro Component Syntax:
// https://docs.astro.build/basics/astro-components/
---

<BaseLayout>
	<div class="stack gap-20 lg:gap-48">
		<div class="wrapper stack gap-8 lg:gap-20">
			<header class="hero">
				<div class="hero-particles" aria-hidden="true">
					<HeroParticles client:load />
				</div>
				<Hero
					title="Hello, my name is markab-j"
					tagline="Welcome to my personal space on the web."
					align="start"
				>
					<div class="interests">
						<TextType
							client:load
							as="p"
							prefix="I like "
							text={['developing', 'writing', 'planning']}
							typingSpeed={90}
							pauseDuration={1800}
							deletingSpeed={40}
							typeEffect="rise"
							cursorStyle="bar"
							cursorColor="var(--ink-coral)"
							prefixColor="var(--gray-200)"
							textColors={['var(--link-color)', 'var(--ink-coral)', 'var(--ink-peach)']}
						/>
					</div>
				</Hero>

				<img
					alt="markab-j logo"
					width="480"
					height="490"
					src="/favicon.svg"
				/>
			</header>
		</div>

		<main class="wrapper stack gap-20 lg:gap-48">
			<section class="section with-cta">
				<header class="section-header stack gap-2 lg:gap-4">
					<h3>Selected Work</h3>
					<p>A selection of my projects.</p>
				</header>

				<div class:list={['gallery', 'work-gallery', { 'single-project': projects.length === 1 }]}>
					<Masonry
						client:visible
						items={projects.map(({ id, data }) => ({
							id,
							title: data.title,
							description: data.description,
							url: `/work/${id}/`,
							...(data.img ? { img: data.img, alt: data.img_alt } : { width: 600, height: 400 }),
						}))}
						columns={projects.length === 1 ? 1 : 'auto'}
						columnWidth={360}
						gap={24}
						radius={24}
						captions="always"
						hoverEffect="lift"
						lightbox={false}
						draggable={false}
						className="work-masonry"
					/>
				</div>

				<div class="cta">
					<CallToAction href="/work/">
						View All
						<Icon icon="arrow-right" size="1.2em" />
					</CallToAction>
				</div>
			</section>

			<section class="section" aria-labelledby="built-with-title">
				<header class="section-header stack gap-2 lg:gap-4">
					<h3 id="built-with-title">Technologies</h3>
					<p>Languages, frameworks, and tools.</p>
				</header>

				<div class="gallery logo-gallery">
					<TechLogoLoop client:visible />
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
	}

	.hero-particles {
		position: absolute;
		inset-block: -2.5rem;
		inset-inline: calc(50% - 50vw);
		z-index: -1;
		pointer-events: none;
		mask-image: linear-gradient(to bottom, transparent, black 10%, black 80%, transparent);
	}

	.hero :global(.title) {
		font-weight: 750;
	}

	.hero :global(.tagline) {
		font-weight: 500;
	}

	.interests {
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		font-weight: 600;
	}

	.interests :global(.text-type) {
		min-height: 1.5em;
		min-width: 18ch;
		line-height: 1.5;
	}

	.hero img {
		aspect-ratio: 5 / 4;
		object-fit: contain;
		object-position: top;
		filter:
			drop-shadow(0.5px 0 0 var(--brand-500))
			drop-shadow(-0.5px 0 0 var(--brand-500))
			drop-shadow(0 0.5px 0 var(--brand-500))
			drop-shadow(0 -0.5px 0 var(--brand-500))
			drop-shadow(0 12px 20px rgb(18 55 53 / 18%));
	}

	@media (min-width: 50em) {
		.hero {
			display: grid;
			grid-template-columns: 6fr 4fr;
			padding-inline: 2.5rem;
			gap: 3.75rem;
		}

		.interests {
			margin-top: 0.5rem;
			font-size: var(--text-xl);
		}

		.hero img {
			aspect-ratio: 3 / 4;
			object-fit: contain;
		}
	}

	/* ====================================================== */

	.section {
		display: grid;
		gap: 2rem;
	}

	.logo-gallery {
		min-width: 0;
	}

	.section-header {
		justify-self: center;
		text-align: center;
		max-width: 50ch;
		font-size: var(--text-md);
		color: var(--gray-300);
	}

	.section-header h3 {
		font-size: var(--text-2xl);
	}

	@media (min-width: 50em) {
		.section {
			grid-template-columns: repeat(4, 1fr);
			grid-template-areas: 'header header header header' 'gallery gallery gallery gallery';
			gap: 5rem;
		}

		.section.with-cta {
			grid-template-areas: 'header header header cta' 'gallery gallery gallery gallery';
		}

		.section-header {
			grid-area: header;
			font-size: var(--text-lg);
		}

		.section-header h3 {
			font-size: var(--text-4xl);
		}

		.with-cta .section-header {
			justify-self: flex-start;
			text-align: left;
		}

		.gallery {
			grid-area: gallery;
		}

		.cta {
			grid-area: cta;
		}
	}

</style>
