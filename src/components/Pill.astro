---
interface Props {
	tone?: 'mint' | 'lime' | 'peach' | 'coral';
}
const { tone = 'mint' } = Astro.props;
---

<div class="pill" style={{ '--pill-color': `var(--color-${tone})` }}>
	<slot />
</div>

<style>
	.pill {
		display: flex;
		padding: 0.5rem 1rem;
		gap: 0.5rem;
		color: var(--accent-text-over);
		border: 1px solid var(--pill-color);
		background-color: var(--pill-color);
		border-radius: 999rem;
		font-size: var(--text-md);
		line-height: 1.35;
		white-space: nowrap;
	}
</style>
