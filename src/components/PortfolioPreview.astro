---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'work'>;
}

const { data, id } = Astro.props.project;
---

<a class:list={['card', { 'without-image': !data.img }]} href={`/work/${id}`}>
	<span class="title">{data.title}</span>
	{data.img ? (
		<Fragment>
			<img src={data.img} alt={data.img_alt || ''} loading="lazy" decoding="async" data-theme-image={data.img_dark ? 'light' : undefined} />
			{data.img_dark && <img src={data.img_dark} alt={data.img_alt || ''} loading="lazy" decoding="async" data-theme-image="dark" />}
		</Fragment>
	) : (
		<p class="description">{data.description}</p>
	)}
</a>

<style>
	.card {
		display: grid;
		grid-template: auto minmax(0, 1fr) / auto 1fr;
		height: 11rem;
		background: var(--gradient-subtle);
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		overflow: hidden;
		box-shadow: var(--shadow-sm);
		text-decoration: none;
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		font-weight: 500;
		transition: box-shadow var(--theme-transition);
	}

	.card:hover {
		box-shadow: var(--shadow-md);
	}

	.title {
		grid-area: 1 / 1 / 2 / 2;
		z-index: 1;
		margin: 0.5rem;
		padding: 0.5rem 1rem;
		background: var(--gray-999);
		color: var(--gray-200);
		border-radius: 0.375rem;
	}

	.without-image {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 1rem;
		padding: 1.5rem;
		background: var(--gray-999_40);
	}

	.without-image .title {
		margin: 0;
		padding: 0;
		background: none;
		font-size: var(--text-xl);
	}

	.description {
		font-family: var(--font-body);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.5;
		color: var(--gray-300);
	}

	img {
		grid-area: 2 / 1 / 3 / 3;
		width: 100%;
		height: 100%;
		min-height: 0;
		padding: 0 1.5rem 1.5rem;
		object-fit: contain;
	}

	@media (min-width: 50em) {
		.card {
			height: 22rem;
			border-radius: 1.5rem;
		}

		.title {
			border-radius: 0.9375rem;
		}
	}
</style>
