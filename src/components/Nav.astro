---
import Icon from './Icon.astro';
import type { iconPaths } from './IconPaths';
import ThemeToggle from './ThemeToggle.astro';
import SiteGooeyNav from './SiteGooeyNav.jsx';
import StaggeredMenu from './react-bits/StaggeredMenu.jsx';
import './MobileMenu.css';

/** Main menu items */
const textLinks: { label: string; href: string }[] = [
	{ label: 'Home', href: '/' },
	{ label: 'Work', href: '/work' },
	{ label: 'About', href: '/about' },
];

/** Social profiles. */
const iconLinks: { label: string; href: string; icon: keyof typeof iconPaths }[] = [
	{ label: 'X (Twitter)', href: 'https://x.com/markab_j', icon: 'x-logo' },
	{ label: 'GitHub', href: 'https://github.com/markab-j', icon: 'github-logo' },
];

/** Test if a link is pointing to the current page. */
const isCurrentPage = (href: string) => {
	let pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
	if (pathname.at(0) !== '/') pathname = '/' + pathname;
	pathname = pathname.replace(/^\/index\.html$/, '/').replace(/(?:\.html|\/)$/, '') || '/';
	return pathname === href || (href !== '/' && pathname.startsWith(`${href}/`));
};
---

<header class="site-nav">
	<div class="menu-header" data-reveal>
		<a href="/" class="site-title">
			<img src="/favicon.svg" width="32" height="32" alt="" />
			markab-j
		</a>
	</div>
	<div class="desktop-navigation" data-reveal>
		<SiteGooeyNav
			items={textLinks}
			initialActiveIndex={Math.max(0, textLinks.findIndex(({ href }) => isCurrentPage(href)))}
			client:media="(min-width: 50em)"
			transition:persist="primary-navigation"
			transition:persist-props
		/>
	</div>
	<div class="menu-footer" data-reveal>
		<div class="socials">
			{iconLinks.map(({ href, icon, label }) => (
				<a href={href} class="social">
					<span class="sr-only">{label}</span>
					<Icon icon={icon} />
				</a>
			))}
		</div>
		<ThemeToggle />
	</div>
	<div class="mobile-navigation">
		<StaggeredMenu
			client:media="(max-width: 49.999em)"
			items={textLinks.map(({ label, href }) => ({
				label, link: href, ariaLabel: `Go to ${label}`, current: isCurrentPage(href),
			}))}
			socialItems={iconLinks.map(({ label, href }) => ({ label, link: href }))}
			logoUrl="/favicon.svg"
			logoAlt="markab-j"
			colors={['var(--color-peach)', 'var(--color-coral)']}
			menuButtonColor="var(--gray-0)"
			openMenuButtonColor="var(--gray-0)"
			accentColor="var(--ink-coral)"
			changeMenuColorOnOpen={false}
			isFixed
		>
			<div class="mobile-theme">
				<span>Theme</span>
				<ThemeToggle />
			</div>
		</StaggeredMenu>
	</div>
	<noscript>
		<nav aria-label="Main navigation" class="fallback-navigation">
			{textLinks.map(({ label, href }) => (
				<a href={href} aria-current={isCurrentPage(href) ? 'page' : null}>{label}</a>
			))}
		</nav>
		<style is:inline>.mobile-navigation { display: none !important; }</style>
	</noscript>
</header>

<style>
	.site-nav {
		z-index: 9999;
		position: relative;
		min-height: 5rem;
		font-family: var(--font-brand);
		font-weight: 500;
		margin-bottom: 3.5rem;
	}

	.menu-header,
	.desktop-navigation,
	.menu-footer {
		display: none;
	}

	.site-title {
		display: flex;
		gap: 0.5rem;
		align-items: center;
		line-height: 1.1;
		color: var(--gray-0);
		text-decoration: none;
		font-size: var(--text-lg);
	}

	.menu-footer,
	.socials {
		align-items: center;
		gap: 0.625rem;
	}

	.socials {
		display: flex;
		font-size: var(--text-xl);
	}

	.social {
		display: flex;
		padding: 0.375rem;
		text-decoration: none;
		color: var(--accent-dark);
	}

	.social:hover,
	.social:focus {
		color: var(--link-color);
	}

	.mobile-theme {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-top: 1rem;
		border-top: 1px solid var(--gray-800);
		color: var(--gray-200);
	}

	.fallback-navigation {
		display: flex;
		justify-content: center;
		gap: 1.5rem;
		padding: 1.5rem;
	}

	@media (min-width: 50em) {
		.site-nav {
			display: grid;
			grid-template-columns: 1fr auto 1fr;
			align-items: center;
			padding: 2.5rem 5rem;
			gap: 1rem;
		}

		.menu-header,
		.desktop-navigation,
		.menu-footer {
			display: flex;
		}

		.menu-footer {
			justify-self: end;
		}

		.mobile-navigation {
			display: none;
		}
	}
</style>
