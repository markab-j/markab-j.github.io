---
// Learn about using Astro layouts:
// https://docs.astro.build/en/basics/layouts/

import { ClientRouter } from 'astro:transitions';
import Footer from '../components/Footer.astro';
// Component Imports
import MainHead from '../components/MainHead.astro';
import Nav from '../components/Nav.astro';
import ClickSpark from '../components/react-bits/ClickSpark.jsx';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
}

const { title, description } = Astro.props;
---

<html lang="en" transition:animate="none">
	<head>
		<MainHead title={title} description={description} />
		<ClientRouter />
	</head>
	<body>
		<ClickSpark
			client:load
			transition:persist="click-spark"
			transition:persist-props
			captureDocument
			style={{ position: 'fixed', inset: 0, pointerEvents: 'none', zIndex: 10000 }}
			sparkColor="#9CDBD9"
			shape="star"
			sparkCount={6}
			sparkSize={16}
			sparkRadius={36}
			duration={700}
		/>
		<div class="stack backgrounds">
			<Nav />
			<slot />
			<Footer />
		</div>


		<script>
			// Document listeners continue working through client-side page swaps.
			const preventContentAction = (event: Event) => {
				const target = event.target;
				if (
					target instanceof Element &&
					target.closest('input, textarea, [contenteditable]:not([contenteditable="false"])')
				) return;
				event.preventDefault();
			};
			document.addEventListener('dragstart', preventContentAction);
			document.addEventListener('contextmenu', preventContentAction);
		</script>

		<style>
			:root {
				--bg-scale: 1;
				--bg-gradient-size: 100%;
				--bg-blend-mode: normal;
				--bg-image-subtle-1: radial-gradient(ellipse at center, var(--background-glow), transparent 70%);
				--bg-image-subtle-2: var(--bg-image-subtle-1);
			}

			.backgrounds {
				min-height: 100vh;
				isolation: isolate;
				background:
					radial-gradient(ellipse 80% 45rem at 80% 0%, var(--background-glow), transparent),
					radial-gradient(ellipse 70% 35rem at 20% 100%, var(--background-glow), transparent),
					var(--gray-999);
			}

			@media (forced-colors: active) {
				.backgrounds {
					background: none;
				}
			}
		</style>
	</body>
</html>
