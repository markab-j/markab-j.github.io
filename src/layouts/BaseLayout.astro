---
// Learn about using Astro layouts:
// https://docs.astro.build/en/basics/layouts/

import Footer from '../components/Footer.astro';
// Component Imports
import MainHead from '../components/MainHead.astro';
import Nav from '../components/Nav.astro';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
}

const { title, description } = Astro.props;
---

<html lang="en">
	<head>
		<MainHead title={title} description={description} />
	</head>
	<body>
		<div class="stack backgrounds">
			<Nav />
			<slot />
			<Footer />
		</div>

		<style>
			:root {
				--bg-scale: 1;
				--bg-gradient-size: 100%;
				--bg-blend-mode: normal;
				--bg-image-subtle-1: radial-gradient(ellipse at center, var(--background-glow), transparent 70%);
				--bg-image-subtle-2: var(--bg-image-subtle-1);
			}

			.backgrounds {
				min-height: 100vh;
				isolation: isolate;
				background:
					radial-gradient(ellipse 80% 45rem at 80% 0%, var(--background-glow), transparent),
					radial-gradient(ellipse 70% 35rem at 20% 100%, var(--background-glow), transparent),
					var(--gray-999);
			}

			@media (forced-colors: active) {
				.backgrounds {
					background: none;
				}
			}
		</style>
	</body>
</html>
